{
  "name": "gamerhub-ai-game-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start:local": "tsx scripts/start-gamerhub.ts",
    "setup:python": "tsx scripts/setup-fastapi.ts",
    "dev:backend": "tsx scripts/start-fastapi.ts",
    "test:fastapi": "tsx scripts/start-fastapi.ts --test",
    "dev": "pnpm dev:infra && pnpm db:migrate && pnpm --parallel --filter @gamerhub/studio-web --filter @gamerhub/local-dev dev",
    "dev:bootstrap": "tsx scripts/bootstrap-dev.ts",
    "dev:infra": "tsx scripts/start-dev-infra.ts",
    "dev:infra:down": "docker compose -f infra/compose/dev.yml down",
    "dev:licensed": "tsx scripts/start-e2e-stack.ts",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test tests/e2e",
    "test:web": "playwright test tests/e2e/unity-web-browser-matrix.spec.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:flow": "tsx scripts/test-flow.ts",
    "verify:agent": "tsx scripts/verify-agent.ts",
    "test:reliability": "vitest run tests/reliability",
    "test:unity": "tsx scripts/run-unity-tests.ts --cycles 1 --required-successes 1",
    "test:unity:soak": "tsx scripts/run-unity-tests.ts --cycles 100 --required-successes 95",
    "stack:e2e": "tsx scripts/start-e2e-stack.ts",
    "env:doctor": "tsx scripts/env-doctor.ts",
    "env:doctor:local": "tsx scripts/env-doctor.ts --profile local",
    "infra:doctor": "tsx scripts/infra-doctor.ts",
    "model:doctor": "tsx scripts/model-doctor.ts",
    "agent:doctor": "tsx scripts/agent-doctor.ts",
    "unity:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/complete-unity-install.ps1",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "fixtures:install-unity-runner": "tsx scripts/install-runner-fixture.ts",
    "fixtures:apply-defect": "tsx scripts/apply-defect-fixture.ts",
    "generate:contracts": "tsx scripts/generate-contracts.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "sharp": "^0.35.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7"
  }
}
